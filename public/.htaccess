# Invest Master — Hostinger (Apache / LiteSpeed) configuration
# This file is copied into dist/ at build time and uploaded with the site.

# ── Protect API includes ──────────────────────────────────────────────────
# _config.php (DB password) and _db.php are includes only — never served or
# hit directly over the web.
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

# ── Single-page-app fallback ──────────────────────────────────────────────
# Serve index.html for any path that isn't a real file/folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Correct MIME types ────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json application/manifest+json \
    image/svg+xml
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Long-cache the immutable, content-hashed build assets first…
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # …then force the entry, service worker and manifest to always revalidate,
  # so a new deploy goes live immediately (this block wins for these files).
  <FilesMatch "(^index\.html|sw\.js|registerSW\.js|workbox-[^/]+\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
